\ProvidesPackage{lpalign}[Jun 28, 2026: v1.4 final of Jamie Fravel's lpalign macro package]

\RequirePackage{amsmath, expl3, l3keys2e, mathtools, stackengine}
%%begin novalidate


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Horizontal Spacing  %%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A few spacing macros that I use often.

\def\hskp{\hskip.5em\relax}
\def\Hskp{\hskip1em\relax}
\def\HSkp{\hskip2em\relax}
\def\HSKp{\hskip3em\relax}
\def\HSKP{\hskip4em\relax}

\def\htrg{\hskip-.5em\relax}
\def\Htrg{\hskip-1em\relax}
\def\HTrg{\hskip-2em\relax}
\def\HTRg{\hskip-3em\relax}
\def\HTRG{\hskip-4em\relax}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Vertical Spacing  %%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Vertical versions of the above spacing macros.

\def\vskp{\par\vspace{.5em}\relax}
\def\Vskp{\par\vspace{1em}\relax}
\def\VSkp{\par\vspace{2em}\relax}
\def\VSKp{\par\vspace{3em}\relax}
\def\VSKP{\par\vspace{4em}\relax}

\def\vtrg{\par\vspace{-.5em}\relax}
\def\Vtrg{\par\vspace{-1em}\relax}
\def\VTrg{\par\vspace{-2em}\relax}
\def\VTRg{\par\vspace{-3em}\relax}
\def\VTRG{\par\vspace{-4em}\relax}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Spaced Evaluators  %%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A few binary evaluators with extra space on either side. I like these for aligned inequality constraints.

\ExplSyntaxOn
\dim_new:N \evaluator_spacing
\dim_gset:Nn \evaluator_spacing { 0.25em }
\keys_define:nn { lpalign/package }
	{
	evaluator_spacing .dim_gset:N = \evaluator_spacing
	}

\newcommand{\eq}{=}

\newcommand{\EQ}{\hspace{\dim_use:N \evaluator_spacing}=\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\LS}{\hspace{\dim_use:N \evaluator_spacing}<\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\GS}{\hspace{\dim_use:N \evaluator_spacing}>\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\LE}{\hspace{\dim_use:N \evaluator_spacing}\leq\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\GE}{\hspace{\dim_use:N \evaluator_spacing}\geq\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\IN}{\hspace{\dim_use:N \evaluator_spacing}\in\hspace{\dim_use:N \evaluator_spacing}}

\newcommand{\NEQ}{\hspace{\dim_use:N \evaluator_spacing}\neq\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\SUB}{\hspace{\dim_use:N \evaluator_spacing}\subset\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\SUP}{\hspace{\dim_use:N \evaluator_spacing}\supset\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\SEQ}{\hspace{\dim_use:N \evaluator_spacing}\subseteq\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\SPQ}{\hspace{\dim_use:N \evaluator_spacing}\supseteq\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\NIN}{\hspace{\dim_use:N \evaluator_spacing}\notin\hspace{\dim_use:N \evaluator_spacing}}
\ExplSyntaxOff



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Overindexed Delimiters  %%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Spacing helpers for overindexed display operators. These preserve the usual
% subscript/superscript syntax while placing long limits in mathclap boxes.

\NewDocumentCommand{\smashprep}{mmm}
  {
    #1
    \IfValueT{#2}{\sb{\mathclap{#2}}}
    \IfValueT{#3}{\sp{\mathclap{#3}}}
  }
\NewDocumentCommand{\SUM}{e{_^}}{\smashprep{\sum}{#1}{#2}}
\NewDocumentCommand{\PROD}{e{_^}}{\smashprep{\prod}{#1}{#2}}
\NewDocumentCommand{\CUP}{e{_^}}{\smashprep{\bigcup}{#1}{#2}}
\NewDocumentCommand{\CAP}{e{_^}}{\smashprep{\bigcap}{#1}{#2}}
\NewDocumentCommand{\VEE}{e{_^}}{\smashprep{\bigvee}{#1}{#2}}
\NewDocumentCommand{\WEDGE}{e{_^}}{\smashprep{\bigwedge}{#1}{#2}}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  lpalign  %%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% An environment macro built on the alignat environment from the amsmath package which helps to format mathematical programming problems aesthetically.

\ExplSyntaxOn
% Package defaults
\dim_new:N \g_lpalign_default_objective_sep
\dim_new:N \g_lpalign_default_qualifier_sep
\dim_new:N \g_lpalign_default_gutter_sep
\dim_gset:Nn \g_lpalign_default_objective_sep { 0em }
\dim_gset:Nn \g_lpalign_default_qualifier_sep { 2em }
\dim_gset:Nn \g_lpalign_default_gutter_sep { 0.75em }
% Text Inputs
\tl_new:N \lpalign_vars_text
\tl_new:N \lpalign_vars_style
\tl_new:N \lpalign_st_text
\tl_new:N \lpalign_gutter_mode
% Boxes
\box_new:N \lpalign_sense_box
\box_new:N \lpalign_st_box
% Dimensions
\dim_new:N \lpalign_sense_shift
\dim_new:N \lpalign_sense_width
\dim_new:N \lpalign_st_shift
\dim_new:N \lpalign_st_width
\dim_new:N \lpalign_objective_sep
\dim_new:N \lpalign_qualifier_sep
\dim_new:N \lpalign_gutter_sep
\dim_new:N \lpalign_gutter_width
% Package options
\keys_define:nn { lpalign/package }
	{
	lp_objective_sep .dim_gset:N = \g_lpalign_default_objective_sep,
	lp_objective_sep .initial:n = 0em,
	lp_qualifier_sep .dim_gset:N = \g_lpalign_default_qualifier_sep,
	lp_qualifier_sep .initial:n = 2em,
	lp_gutter_sep .dim_gset:N = \g_lpalign_default_gutter_sep,
	lp_gutter_sep .initial:n = 0.75em,
	}
% Key Options
\keys_define:nn { lpalign/lp }
	{
	vars .tl_set:N = \lpalign_vars_text,
	vars-style .tl_set:N = \lpalign_vars_style,
	% Sense Parameters
	sense-shift .dim_set:N = \lpalign_sense_shift,
	% s.t. Parameters
	st .tl_set:N = \lpalign_st_text,
	st-shift .dim_set:N = \lpalign_st_shift,
	% Objective Sep
	objective-sep .dim_set:N = \lpalign_objective_sep,
	% Qualifier Sep
	qualifier-sep .dim_set:N = \lpalign_qualifier_sep,
	% Gutter Sep
	gutter-sep .dim_set:N = \lpalign_gutter_sep,
	% Gutter Mode
	gutter-mode .choice:,
	gutter-mode / overlay .code:n = \tl_set:Nn \lpalign_gutter_mode { overlay },
	gutter-mode / aligned .code:n = \tl_set:Nn \lpalign_gutter_mode { aligned },
	}
\cs_new_protected:Npn \lpalign_lp_reset:
	{
	\tl_clear:N \lpalign_vars_text
	\tl_set:Nn \lpalign_vars_style { \scriptstyle }
	\tl_set:Nn \lpalign_st_text { s.t. }
	\tl_set:Nn \lpalign_gutter_mode { overlay }
	\dim_set:Nn \lpalign_sense_shift { 0pt }
	\dim_set:Nn \lpalign_st_shift { 0pt }
	\dim_set_eq:NN \lpalign_objective_sep \g_lpalign_default_objective_sep
	\dim_set_eq:NN \lpalign_qualifier_sep \g_lpalign_default_qualifier_sep
	\dim_set_eq:NN \lpalign_gutter_sep \g_lpalign_default_gutter_sep
	}
% lpalign Environment Setup
\cs_new_protected:Npn \lpalign_lp_setup:nn #1#2
	{
	\lpalign_lp_reset:
	\keys_set:nn { lpalign/lp } { #1 }
  % Sense Box/width
  \hbox_set:Nn \lpalign_sense_box
		{ \stackunder
			{ #2 }
			{ \tl_if_blank:VF \lpalign_vars_text
				{$\lpalign_vars_style\tl_use:N \lpalign_vars_text$ }
		}}
  \dim_set:Nn \lpalign_sense_width{ \box_wd:N \lpalign_sense_box }
  % s.t. Box/Width
  \hbox_set:Nn \lpalign_st_box{ \tl_use:N \lpalign_st_text }
  \dim_set:Nn \lpalign_st_width{ \box_wd:N \lpalign_st_box }
	% Gutter Width
	\dim_compare:nNnTF \lpalign_sense_width > \lpalign_st_width
			{ \dim_set:Nn \lpalign_gutter_width 
				{ \lpalign_sense_width + \lpalign_gutter_sep }}
			{ \dim_set:Nn \lpalign_gutter_width 
				{ \lpalign_st_width + \lpalign_gutter_sep }}
	}
% Print Sense Box
\cs_new_protected:Npn \lpalign_print_sense:
	{\makebox[\dim_use:N \lpalign_gutter_width][r]
		{\raisebox
			{\dim_use:N \lpalign_sense_shift}
			{\box_use:N \lpalign_sense_box}
		\hspace{\dim_use:N \lpalign_gutter_sep}}
	}
% Print s.t. Box
\cs_new_protected:Npn \lpalign_print_st:
	{\makebox[\dim_use:N \lpalign_gutter_width][r]
		{\raisebox
			{\dim_use:N \lpalign_st_shift}
			{\box_use:N \lpalign_st_box}
		\hspace{\dim_use:N \lpalign_gutter_sep}}
	}
% Add Qualifier Sep
\cs_new_protected:Npn \lpalign_lp_format_body:n #1
	{\tl_set:Nn \l_tmpa_tl {#1}
	\tl_replace_all:Nnn \l_tmpa_tl 
		{&&}
		{\hspace{\dim_use:N \lpalign_qualifier_sep} &&}
	\tl_use:N \l_tmpa_tl
	}
% Add Qualifier Sep and prepend an empty gutter cell on later rows.
\cs_new_protected:Npn \lpalign_lp_format_body_aligned:n #1
	{
	\tl_set:Nn \l_tmpa_tl {#1}
	\tl_replace_all:Nnn \l_tmpa_tl
		{&&}
		{\hspace{\dim_use:N \lpalign_qualifier_sep} &&}
	\tl_replace_all:Nnn \l_tmpa_tl
		{\\}
		{\\ &}
	\tl_use:N \l_tmpa_tl
	}
% Overlay gutter mode.
\cs_new_protected:Npn \lpalign_lp_print_overlay:nn #1#2
	{
	\begin{alignat}{2}
	\lpalign_print_sense:
	\begin{aligned}#1\end{aligned}
	\span\span\span\omit\hfill
	\\[\dim_use:N \lpalign_objective_sep]
	\lpalign_print_st: \lpalign_lp_format_body:n {#2}
	\end{alignat}
	}
% Aligned gutter mode.
\cs_new_protected:Npn \lpalign_lp_print_aligned:nn #1#2
	{
	\begin{alignat}{2}
	\lpalign_print_sense: & \begin{aligned}#1\end{aligned}
	\span\span\omit\hfill
	\\[\dim_use:N \lpalign_objective_sep]
	\lpalign_print_st: & \lpalign_lp_format_body_aligned:n {#2}
	\end{alignat}
	}
% Overlay gutter mode, starred.
\cs_new_protected:Npn \lpalign_lp_print_overlay_star:nn #1#2
	{
	\begin{alignat*}{2}
	\lpalign_print_sense:
	\begin{aligned}#1\end{aligned}
	\span\span\span\omit\hfill
	\\[\dim_use:N \lpalign_objective_sep]
	\lpalign_print_st: \lpalign_lp_format_body:n {#2}
	\end{alignat*}
	}
% Aligned gutter mode, starred.
\cs_new_protected:Npn \lpalign_lp_print_aligned_star:nn #1#2
	{
	\begin{alignat*}{2}
	\lpalign_print_sense: & \begin{aligned}#1\end{aligned}
	\span\span\omit\hfill
	\\[\dim_use:N \lpalign_objective_sep]
	\lpalign_print_st: & \lpalign_lp_format_body_aligned:n {#2}
	\end{alignat*}
	}
% Environment Main
\NewDocumentEnvironment{lpalign}{O{}mm+b}
	{
  \lpalign_lp_setup:nn {#1}{#2}
  \tl_if_eq:NnTF \lpalign_gutter_mode { aligned }
  	{ \lpalign_lp_print_aligned:nn {#3}{#4} }
  	{ \lpalign_lp_print_overlay:nn {#3}{#4} }
	}
	{\ignorespacesafterend}
 % Environment* Main
\NewDocumentEnvironment{lpalign*}{O{}mm+b}
	{
  \lpalign_lp_setup:nn {#1} {#2}
  \tl_if_eq:NnTF \lpalign_gutter_mode { aligned }
  	{ \lpalign_lp_print_aligned_star:nn {#3}{#4} }
  	{ \lpalign_lp_print_overlay_star:nn {#3}{#4} }
	}
	{\ignorespacesafterend}
\ExplSyntaxOff



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Named Paragraphs  %%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A paragraph marker that takes a title and key-value options. If the paragraph
% is labeled, then references use the abbreviation rather than a counter
% number when one is supplied.

\makeatletter
\ExplSyntaxOn
% Package defaults
\tl_new:N \g_lpalign_namedpara_default_indent_tl
\tl_new:N \g_lpalign_namedpara_default_flush_tl
\tl_new:N \g_lpalign_namedpara_default_before_tl
\tl_new:N \g_lpalign_namedpara_default_after_tl
\keys_define:nn { lpalign/package }
 {
  namedpara_indent .tl_gset:N = \g_lpalign_namedpara_default_indent_tl,
  namedpara_indent .initial:n = 2em,
  namedparabefore .tl_gset:N = \g_lpalign_namedpara_default_before_tl,
  namedparabefore .initial:n = ,
  namedparaafter .tl_gset:N = \g_lpalign_namedpara_default_after_tl,
  namedparaafter .initial:n = ,
  namedparaflush .choices:nn = { left, center, right }
   { \tl_gset_eq:NN \g_lpalign_namedpara_default_flush_tl \l_keys_choice_tl },
  namedparaflush .initial:n = left,
 }
\ProcessKeysOptions{ lpalign/package }
% Local state
\tl_new:N \l_lpalign_namedpara_abbreviation_tl
\tl_new:N \l_lpalign_namedpara_indent_tl
\tl_new:N \l_lpalign_namedpara_before_tl
\tl_new:N \l_lpalign_namedpara_after_tl
\tl_new:N \l_lpalign_namedpara_flush_tl
\keys_define:nn { lpalign/namedpara }
 {
  abv .tl_set:N = \l_lpalign_namedpara_abbreviation_tl,
  abbreviation .tl_set:N = \l_lpalign_namedpara_abbreviation_tl,
  indent .tl_set:N = \l_lpalign_namedpara_indent_tl,
  before .tl_set:N = \l_lpalign_namedpara_before_tl,
  after .tl_set:N = \l_lpalign_namedpara_after_tl,
  flush .choices:nn = { left, center, right }
   { \tl_set_eq:NN \l_lpalign_namedpara_flush_tl \l_keys_choice_tl },
 }
\cs_new_protected:Npn \lpalign_namedpara_reset:
 {
  \tl_clear:N \l_lpalign_namedpara_abbreviation_tl
  \tl_set:Nx \l_lpalign_namedpara_indent_tl
   { \tl_use:N \g_lpalign_namedpara_default_indent_tl }
  \tl_set:Nx \l_lpalign_namedpara_before_tl
   { \tl_use:N \g_lpalign_namedpara_default_before_tl }
  \tl_set:Nx \l_lpalign_namedpara_after_tl
   { \tl_use:N \g_lpalign_namedpara_default_after_tl }
  \tl_set:Nx \l_lpalign_namedpara_flush_tl
   { \tl_use:N \g_lpalign_namedpara_default_flush_tl }
 }
\cs_new_protected:Npn \lpalign_namedpara_setup:n #1
 {
  \lpalign_namedpara_reset:
  \tl_if_blank:nTF {#1}
   { }
   {
    \tl_if_in:nnTF {#1} {=}
     { \keys_set:nn { lpalign/namedpara } { #1 } }
     { \tl_set:Nn \l_lpalign_namedpara_abbreviation_tl {#1} }
   }
 }
\cs_new_protected:Npn \lpalign_namedpara_typeset:n #1
 {
  \str_case:VnF \l_lpalign_namedpara_flush_tl
   {
    {left}   { \noindent #1 }
    {center} { \noindent \makebox[\linewidth][c]{#1} }
    {right}  { \noindent \makebox[\linewidth][r]{#1} }
   }
   { \noindent #1 }
 }
\cs_new_protected:Npn \lpalign_namedpara:nn #1#2
 {
  \lpalign_namedpara_setup:n {#2}
  \par
  \lpalign_namedpara_typeset:n
   {
    \hspace*{\tl_use:N \l_lpalign_namedpara_indent_tl}
    \tl_use:N \l_lpalign_namedpara_before_tl
    \textbf{#1}
    \tl_if_blank:VTF \l_lpalign_namedpara_abbreviation_tl
     { }
     {
      \hspace{0.5em}\textbf{(\tl_use:N \l_lpalign_namedpara_abbreviation_tl)}
      \tl_use:N \l_lpalign_namedpara_after_tl
     }
   }
  \tl_if_blank:VTF \l_lpalign_namedpara_abbreviation_tl
   {
    \lpalign@namedpararefstep{Para}
   }
   {
    \exp_args:Nx \lpalign@namedpararefstepabbrev
      { \tl_use:N \l_lpalign_namedpara_abbreviation_tl }
    \xdef\@currentlabel{\tl_use:N \l_lpalign_namedpara_abbreviation_tl}
   }
 }
\ExplSyntaxOff
\newcounter{Para}
\newcounter{NamedPara}
\NewDocumentCommand\paratitle{O{}mo}
    {\hfill\break\indent#1\textbf{#2}
        \IfValueTF{#3}
            {\textbf{(#3)}\refstepcounter{NamedPara}\def\@currentlabel{#3}}
            {\refstepcounter{Para}}
    }
\newcommand{\lpalign@namedpararefstep}[1]{%
  \refstepcounter{#1}%
}
\newcommand{\lpalign@namedpararefstepabbrev}[1]{%
  \let\lpalign@savedtheNamedPara\theNamedPara
  \def\theNamedPara{#1}%
  \refstepcounter{NamedPara}%
  \let\theNamedPara\lpalign@savedtheNamedPara
}
\ExplSyntaxOn
\NewDocumentCommand\namedpara{mO{}}
    {%
      \lpalign_namedpara:nn{#1}{#2}%
    }
\ExplSyntaxOff
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Named SubEquations  %%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A subequations-style environment that uses (#1) as the first index in any
% enclosed equation reference tag. The optional key-value argument controls the
% second-index style and the punctuation between the main tag and the sub-tag.

\newcounter{NamedEq}
\newcounter{lpalignNamedEqSavedEquation}
\makeatletter
\ExplSyntaxOn
% Option state
\tl_new:N \l_lpalign_namedsubeq_style_tl
\tl_new:N \l_lpalign_namedsubeq_punct_tl
\keys_define:nn { lpalign/namedsubeqs }
 {
  style .tl_set:N = \l_lpalign_namedsubeq_style_tl,
  punct .tl_set:N = \l_lpalign_namedsubeq_punct_tl,
  style .initial:n = \alph,
  punct .initial:n = .,
 }
\cs_new_protected:Npn \lpalign@namedsubeqsetup #1
 {
  \tl_if_blank:nTF {#1}
   { \keys_set:nn { lpalign/namedsubeqs } { style = \alph, punct = . } }
   {
    \tl_if_in:nnTF {#1} {=}
     { \keys_set:nn { lpalign/namedsubeqs } { style = \alph, punct = ., #1 } }
     { \keys_set:nn { lpalign/namedsubeqs } { style = #1, punct = . } }
   }
 }
\cs_new:Npn \lpalign@namedsubeqstyle #1
 {
  \exp_args:NV \use:n \l_lpalign_namedsubeq_style_tl {#1}
 }
\cs_new:Npn \lpalign@namedsubeqpunct
 {
  \tl_use:N \l_lpalign_namedsubeq_punct_tl
 }
\ExplSyntaxOff
% Helpers for storing the sub-index text used by \lpsubref/\lpsubeqref.
\newcommand{\lpalign@storesubreftext}[2]{%
  \expandafter\xdef\csname subeqref@#1\endcsname{#2}%
}
\newcommand{\lpalign@sanitizesubeqcurrentlabel}{%
  \ifnum\value{equation}>0\relax
    \protected@edef\@currentlabel{{\p@equation\theequation}}%
  \fi
}
\newcommand{\lpalign@storestandardsubcurrent}[1]{%
  \begingroup
  \protected@edef\lpalign@full{\theequation}%
  \edef\lpalign@prefix{\theparentequation}%
  \let\lpalign@tmp\@empty
  \edef\lpalign@tmpdef{%
    \def\noexpand\lpalign@stripaux####1\lpalign@prefix####2\noexpand\@nil{%
      \def\noexpand\lpalign@tmp{####2}%
    }%
  }%
  \lpalign@tmpdef
  \expandafter\lpalign@stripaux\lpalign@full\@nil
  \ifx\lpalign@tmp\@empty
  \else
    \def\lpalign@stripcontrolsubpunct##1##2\@nil{%
      \ifx##1\textbar
        \def\lpalign@tmp{##2}%
      \else\ifx##1\vert
        \def\lpalign@tmp{##2}%
      \else\ifx##1\mid
        \def\lpalign@tmp{##2}%
      \fi\fi\fi
    }%
    \expandafter\lpalign@stripcontrolsubpunct\lpalign@tmp\@nil
    \global\expandafter\let\csname subeqref@#1\endcsname\lpalign@tmp
  \fi
  \endgroup
}
\let\lpalign@origsubequations\subequations
\let\lpalign@endorigsubequations\endsubequations
\renewenvironment{subequations}%
  {\lpalign@origsubequations
   \let\lpalign@subeqoriglabel\label
   \let\lpalign@subeqorigltxlabel\ltx@label
   \def\lpalign@subeqstoresubcurrent##1{%
     \lpalign@storestandardsubcurrent{##1}%
   }%
   \@ifundefined{theHequation}{}%
     {\renewcommand{\theHequation}{lpalign.subequation.\arabic{parentequation}.\arabic{equation}}}%
   \def\label##1{%
     \lpalign@sanitizesubeqcurrentlabel
     \lpalign@subeqoriglabel{##1}%
     \lpalign@subeqstoresubcurrent{##1}%
   }%
   \def\ltx@label##1{%
     \lpalign@sanitizesubeqcurrentlabel
     \lpalign@subeqorigltxlabel{##1}%
     \lpalign@subeqstoresubcurrent{##1}%
   }}%
  {\lpalign@endorigsubequations}

\NewDocumentEnvironment{namedsubeqs}{mO{}}
  {\begingroup
   \setcounter{lpalignNamedEqSavedEquation}{\value{equation}}%
   \lpalign@namedsubeqsetup{#2}%
   \refstepcounter{NamedEq}
   \@ifundefined{theHequation}{}%
     {\renewcommand{\theHequation}{lpalign.namedparent.\arabic{NamedEq}.\arabic{equation}}}%
   \begin{subequations}
     \def\@currentlabel{#1}
     \renewcommand{\theequation}{#1\lpalign@namedsubeqpunct{\lpalign@namedsubeqstyle{equation}}}
     \def\lpalign@subeqstoresubcurrent##1{%
       \lpalign@storesubreftext{##1}{\lpalign@namedsubeqstyle{equation}}%
     }%
     \@ifundefined{theHequation}{}%
       {\renewcommand{\theHequation}{lpalign.\arabic{NamedEq}.\arabic{equation}}}}
  {\end{subequations}
     \setcounter{equation}{\value{lpalignNamedEqSavedEquation}}%
     \endgroup
     \ignorespacesafterend
     \unskip
  }
\makeatother

% \lpsubref and \lpsubeqref work like \ref and \eqref but only reference the
% secondary, sub-index of the tag. Inside namedsubeqs and standard
% subequations, ordinary \label stores this text automatically. \sublabel
% remains as a compatibility wrapper around \label.
\makeatletter
% Hyperref wrapper used by both sub-reference commands.
\newcommand{\lpalignhyperref}[2]{%
  \@ifundefined{hyperref}{#2}{\hyperref[#1]{#2}}%
}
\newcommand{\lpalign@newsubref}[2]{%
  \lpalign@storesubreftext{#1}{#2}%
}
\newcommand{\lpalignnewsubref}[2]{%
  \lpalign@newsubref{#1}{#2}%
}
\newcommand{\sublabel}[1]{%
  \label{#1}%
  \@ifundefined{lpalign@subeqstoresubcurrent}
    {\lpalign@storestandardsubcurrent{#1}}
    {\lpalign@subeqstoresubcurrent{#1}}%
}
\makeatother
\ExplSyntaxOn
\cs_new:Npn \lpalignsubreftext #1
 {
  \tl_set:Nx \l_tmpa_tl { \csname subeqref@#1\endcsname }
  \regex_replace_once:nnN { ^[\.\-:;,/\s]+ } {} \l_tmpa_tl
  \l_tmpa_tl
 }
