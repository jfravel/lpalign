\ProvidesPackage{lpalign}[Jul 16, 2026: v1.6 of Jamie Fravel's lpalign macro package]

\RequirePackage{IEEEtrantools, expl3, l3keys2e}
\IfFileExists{stackengine.sty}
  {\RequirePackage{stackengine}}
  {\newcommand{\stackunder}[2]{\shortstack[c]{##1\\##2}}}
\IfFileExists{mathtools.sty}
  {\RequirePackage{mathtools}}
  {%
    \makeatletter
    \def\mathclap##1{\mathpalette\lpalignmathclap{##1}}
    \def\lpalignmathclap##1##2{\hbox to 0pt{\hss$\m@th##1##2$\hss}}
    \makeatother
  }
%%begin novalidate


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Horizontal Spacing  %%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A few spacing macros that I use often.

\def\hskp{\hskip.5em\relax}
\def\Hskp{\hskip1em\relax}
\def\HSkp{\hskip2em\relax}
\def\HSKp{\hskip3em\relax}
\def\HSKP{\hskip4em\relax}

\def\htrg{\hskip-.5em\relax}
\def\Htrg{\hskip-1em\relax}
\def\HTrg{\hskip-2em\relax}
\def\HTRg{\hskip-3em\relax}
\def\HTRG{\hskip-4em\relax}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Vertical Spacing  %%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Vertical versions of the above spacing macros.

\def\vskp{\par\vspace{.5em}\relax}
\def\Vskp{\par\vspace{1em}\relax}
\def\VSkp{\par\vspace{2em}\relax}
\def\VSKp{\par\vspace{3em}\relax}
\def\VSKP{\par\vspace{4em}\relax}

\def\vtrg{\par\vspace{-.5em}\relax}
\def\Vtrg{\par\vspace{-1em}\relax}
\def\VTrg{\par\vspace{-2em}\relax}
\def\VTRg{\par\vspace{-3em}\relax}
\def\VTRG{\par\vspace{-4em}\relax}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Spaced Evaluators  %%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A few binary evaluators with extra space on either side. I like these for aligned inequality constraints.

\ExplSyntaxOn
\dim_new:N \evaluator_spacing
\dim_gset:Nn \evaluator_spacing { 0.25em }
\keys_define:nn { lpalign/package }
		{
		evaluator-spacing .dim_gset:N = \evaluator_spacing
		}

\newcommand{\eq}{=}

\newcommand{\EQ}{\hspace{\dim_use:N \evaluator_spacing}=\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\LS}{\hspace{\dim_use:N \evaluator_spacing}<\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\GS}{\hspace{\dim_use:N \evaluator_spacing}>\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\LE}{\hspace{\dim_use:N \evaluator_spacing}\leq\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\GE}{\hspace{\dim_use:N \evaluator_spacing}\geq\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\IN}{\hspace{\dim_use:N \evaluator_spacing}\in\hspace{\dim_use:N \evaluator_spacing}}

\newcommand{\NEQ}{\hspace{\dim_use:N \evaluator_spacing}\neq\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\SUB}{\hspace{\dim_use:N \evaluator_spacing}\subset\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\SUP}{\hspace{\dim_use:N \evaluator_spacing}\supset\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\SEQ}{\hspace{\dim_use:N \evaluator_spacing}\subseteq\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\SPQ}{\hspace{\dim_use:N \evaluator_spacing}\supseteq\hspace{\dim_use:N \evaluator_spacing}}
\newcommand{\NIN}{\hspace{\dim_use:N \evaluator_spacing}\notin\hspace{\dim_use:N \evaluator_spacing}}
\ExplSyntaxOff



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Overindexed Delimiters  %%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Spacing helpers for overindexed display operators. These preserve the usual
% subscript/superscript syntax while placing long limits in mathclap boxes.

\NewDocumentCommand{\smashprep}{mmm}
  {
    #1
    \IfValueT{#2}{\sb{\mathclap{#2}}}
    \IfValueT{#3}{\sp{\mathclap{#3}}}
  }
\NewDocumentCommand{\SUM}{e{_^}}{\smashprep{\sum}{#1}{#2}}
\NewDocumentCommand{\PROD}{e{_^}}{\smashprep{\prod}{#1}{#2}}
\NewDocumentCommand{\CUP}{e{_^}}{\smashprep{\bigcup}{#1}{#2}}
\NewDocumentCommand{\CAP}{e{_^}}{\smashprep{\bigcap}{#1}{#2}}
\NewDocumentCommand{\VEE}{e{_^}}{\smashprep{\bigvee}{#1}{#2}}
\NewDocumentCommand{\WEDGE}{e{_^}}{\smashprep{\bigwedge}{#1}{#2}}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  lpalign  %%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Environments built on IEEEeqnarray from IEEEtrantools for formatting
% mathematical programming problems aesthetically both in code and in text.

\ExplSyntaxOn
% Package defaults
\dim_new:N \g_lpalign_default_objective_sep
\dim_new:N \g_lpalign_default_row_sep
\dim_new:N \g_lpalign_default_qualifier_sep
\dim_new:N \g_lpalign_default_gutter_sep
\tl_new:N \g_lpalign_default_flush
\tl_new:N \g_lpalign_default_vars_style_tl
\tl_new:N \g_lpalign_default_st_tl
% Text inputs
\tl_new:N \lpalign_vars_text
\tl_new:N \lpalign_vars_style
\tl_new:N \lpalign_st_text
\tl_new:N \lpalign_flush
\tl_new:N \l_lpalign_sense_text_tl
\tl_new:N \l_lpalign_objective_text_tl
% Dimensions
\dim_new:N \lpalign_row_sep
\dim_new:N \lpalign_sense_shift
\dim_new:N \lpalign_st_shift
\dim_new:N \lpalign_objective_sep
\dim_new:N \lpalign_qualifier_sep
\dim_new:N \lpalign_gutter_sep

% Package options
\keys_define:nn { lpalign/package }
		{
		objective-sep .dim_gset:N = \g_lpalign_default_objective_sep,
		objective-sep .initial:n = 0em,
		row-sep .dim_gset:N = \g_lpalign_default_row_sep,
		row-sep .initial:n = 0.5em,
		qualifier-sep .dim_gset:N = \g_lpalign_default_qualifier_sep,
		qualifier-sep .initial:n = 2em,
		gutter-sep .dim_gset:N = \g_lpalign_default_gutter_sep,
		gutter-sep .initial:n = 0.75em,
		vars-style .choices:nn =
		  { scriptstyle, scriptscriptstyle, textstyle, displaystyle }
		  {
		    \str_case:Vn \l_keys_choice_tl
	     {
	      {scriptstyle}       { \tl_gset:Nn \g_lpalign_default_vars_style_tl { \scriptstyle } }
	      {scriptscriptstyle} { \tl_gset:Nn \g_lpalign_default_vars_style_tl { \scriptscriptstyle } }
	      {textstyle}         { \tl_gset:Nn \g_lpalign_default_vars_style_tl { \textstyle } }
		      {displaystyle}      { \tl_gset:Nn \g_lpalign_default_vars_style_tl { \displaystyle } }
		     }
		  },
		vars-style .initial:n = scriptstyle,
		st .tl_gset:N = \g_lpalign_default_st_tl,
		st .initial:n = s.t.,
		flush .choices:nn =
		  { a, l, c, r }
		  { \tl_gset_eq:NN \g_lpalign_default_flush \l_keys_choice_tl },
		flush .initial:n = a,
		}
	
% Environment Options
\keys_define:nn { lpalign/lp }
  {
  vars .tl_set:N = \lpalign_vars_text,
  vars-style .tl_set:N = \lpalign_vars_style,
  sense-shift .dim_set:N = \lpalign_sense_shift,
  st .tl_set:N = \lpalign_st_text,
  flush .choices:nn =
  	  { a, l, c, r }
  	  { \tl_set_eq:NN \lpalign_flush \l_keys_choice_tl },
  flush .initial:n = a,
  st-shift .dim_set:N = \lpalign_st_shift,
  objective-sep .dim_set:N = \lpalign_objective_sep,
  row-sep .dim_set:N = \lpalign_row_sep,
  qualifier-sep .dim_set:N = \lpalign_qualifier_sep,
  gutter-sep .dim_set:N = \lpalign_gutter_sep,
  }

\cs_new_protected:Npn \lpalign_setup:n #1
  {
	\tl_clear:N \lpalign_vars_text
	\tl_set_eq:NN \lpalign_vars_style \g_lpalign_default_vars_style_tl
	\tl_set_eq:NN \lpalign_st_text \g_lpalign_default_st_tl
	\tl_set_eq:NN \lpalign_flush \g_lpalign_default_flush
	\dim_set:Nn \lpalign_sense_shift { 0pt }
	\dim_set:Nn \lpalign_st_shift { 0pt }
	\dim_set_eq:NN \lpalign_objective_sep \g_lpalign_default_objective_sep
	\dim_set_eq:NN \lpalign_row_sep \g_lpalign_default_row_sep
	\dim_set_eq:NN \lpalign_qualifier_sep \g_lpalign_default_qualifier_sep
	\dim_set_eq:NN \lpalign_gutter_sep \g_lpalign_default_gutter_sep
	\tl_if_blank:nF {#1}
		{
		\tl_if_in:nnTF {#1} {=}
			{ \keys_set:nn { lpalign/lp } { #1 } }
			{ \tl_set:Nn \lpalign_vars_text {#1} }
		}
	\tl_replace_all:Nnn \lpalign_st_text { ~ } { \c_space_tl }
  }

\cs_new:Npn \lpalign_print_sense:n #1
  {
    \raisebox{\dim_use:N \lpalign_sense_shift}
    {
    \tl_if_blank:VTF \lpalign_vars_text
      { #1 }
      {
        \stackunder{#1}{ $\tl_use:N \lpalign_vars_style \tl_use:N \lpalign_vars_text$ }
      }
    }
  }

\cs_new:Npn \lpalign_print_st:
  { \raisebox{\dim_use:N \lpalign_st_shift}{\tl_use:N \lpalign_st_text} }


\makeatletter
\let\lpalign@orig@theequationdis\theequationdis
\let\lpalign@orig@theIEEEsubequationdis\theIEEEsubequationdis
\let\lpalign@manualtag\@empty
\newcommand{\lpalign@tagform}[1]{%
  \@ifundefined{tagform@}{(#1)}{\tagform@{#1}}%
}
\newcommand{\lpalign@clearmanualtag}{%
  \global\let\lpalign@manualtag\@empty
}
\renewcommand{\theequationdis}{%
  \ifx\lpalign@manualtag\@empty
    \lpalign@orig@theequationdis
  \else
    \lpalign@tagform{\lpalign@manualtag}%
  \fi
}
\renewcommand{\theIEEEsubequationdis}{%
  \ifx\lpalign@manualtag\@empty
    \lpalign@orig@theIEEEsubequationdis
  \else
    \lpalign@tagform{\lpalign@manualtag}%
  \fi
}
\newcommand{\lptag}[1]{%
  \gdef\lpalign@manualtag{#1}%
  \gdef\@currentlabel{#1}%
}
\cs_new_protected:Npn \lpalign_ieee_patch_cr:
  {
    \def\lpalign@IEEEeqnarrayYCR{%
      \@testopt\lpalign@IEEEeqnarrayXCR\z@skip
    }
    \def\lpalign@IEEEeqnarrayXCR[##1]{%
      \ifnum0=`{\fi}%
      \@@IEEEeqnarraycr
      \noalign{%
        \penalty\@eqpen
        \vskip\jot
        \vskip ##1
        \vskip \dim_use:N \lpalign_row_sep\relax
        \lpalign@clearmanualtag
      }%
      &%
    }
    \def\@IEEEeqnarraycr{%
      \@IEEEeqnarrayglobalizestrutstatus&%
      {\ifnum0=`}\fi
      \@ifstar{%
        \global\@eqpen\@M
        \lpalign@IEEEeqnarrayYCR
      }{%
        \global\@eqpen\interdisplaylinepenalty
        \lpalign@IEEEeqnarrayYCR
      }%
    }
  }

\NewDocumentEnvironment{lpalign}{O{}mm}
	{
	\lpalign_setup:n { #1 }
	\lpalign@clearmanualtag
	\dim_add:Nn \lpalign_objective_sep {\dim_use:N \lpalign_row_sep}
	\IEEEeqnarraydefcolsep{1}{\dim_use:N \lpalign_gutter_sep}
	\IEEEeqnarraydefcolsep{2}{\dim_use:N \lpalign_qualifier_sep}
	\let\lpalign@orig@IEEEeqnarraycr\@IEEEeqnarraycr
	\lpalign_ieee_patch_cr:
	\tl_set:Nn \l_lpalign_sense_text_tl { #2 }
	\tl_if_eq:NnT \lpalign_flush {a}
		{
		\begin{IEEEeqnarray}{u1rL2l}
		\lpalign_print_sense:n { \tl_use:N \l_lpalign_sense_text_tl }
		& #3 \span\span\hfill
		\lpalign@orig@IEEEeqnarraycr[\dim_use:N \lpalign_objective_sep]\lpalign@clearmanualtag
		\lpalign_print_st: & 
		}
	\tl_if_eq:NnT \lpalign_flush {l}
		{
		\begin{IEEEeqnarray}{u1l2l}
		\lpalign_print_sense:n { \tl_use:N \l_lpalign_sense_text_tl }
		& #3 \span\hfill
		\lpalign@orig@IEEEeqnarraycr[\dim_use:N \lpalign_objective_sep]\lpalign@clearmanualtag
		\lpalign_print_st: & 
		}
	\tl_if_eq:NnT \lpalign_flush {c}
		{
		\begin{IEEEeqnarray}{u1c2l}
		\lpalign_print_sense:n { \tl_use:N \l_lpalign_sense_text_tl }
		& #3 \span\hfill
		\lpalign@orig@IEEEeqnarraycr[\dim_use:N \lpalign_objective_sep]\lpalign@clearmanualtag
		\lpalign_print_st: & 
		}
	\tl_if_eq:NnT \lpalign_flush {r}
		{
		\begin{IEEEeqnarray}{u1r2l}
		\lpalign_print_sense:n { \tl_use:N \l_lpalign_sense_text_tl }
		& #3 \span\hfill
		\lpalign@orig@IEEEeqnarraycr[\dim_use:N \lpalign_objective_sep]\lpalign@clearmanualtag
		\lpalign_print_st: & 
		}
	}
	{
	\end{IEEEeqnarray}
	\lpalign@clearmanualtag
	\let\@IEEEeqnarraycr\lpalign@orig@IEEEeqnarraycr
	\ignorespacesafterend
	}

