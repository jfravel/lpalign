\ProvidesPackage{lpalign}[Jun 25, 2026: v1.2 of Jamie Fravel's lpalign macro package]

\RequirePackage{amsmath, expl3}
%%begin novalidate


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Horizontal Spacing  %%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A few spacing macros that I use often.

\def\hskp{\hskip.5em\relax}
\def\Hskp{\hskip1em\relax}
\def\HSkp{\hskip2em\relax}
\def\HSKp{\hskip3em\relax}
\def\HSKP{\hskip4em\relax}

\def\htrg{\hskip-.5em\relax}
\def\Htrg{\hskip-1em\relax}
\def\HTrg{\hskip-2em\relax}
\def\HTRg{\hskip-3em\relax}
\def\HTRG{\hskip-4em\relax}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Vertical Spacing  %%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Vertical versions of the above spacing macros.

\def\vskp{\par\vspace{.5em}\relax}
\def\Vskp{\par\vspace{1em}\relax}
\def\VSkp{\par\vspace{2em}\relax}
\def\VSKp{\par\vspace{3em}\relax}
\def\VSKP{\par\vspace{4em}\relax}

\def\vtrg{\par\vspace{-.5em}\relax}
\def\Vtrg{\par\vspace{-1em}\relax}
\def\VTrg{\par\vspace{-2em}\relax}
\def\VTRg{\par\vspace{-3em}\relax}
\def\VTRG{\par\vspace{-4em}\relax}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Spaced Evaluators  %%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A few binary evaluators with extra space on either side. I like these for aligned inequality constraints.

\newcommand{\eq}{=}

\newcommand{\EQ}{\hskp=\hskp}
\newcommand{\LS}{\hskp<\hskp}
\newcommand{\GS}{\hskp>\hskp}
\newcommand{\LE}{\hskp\leq\hskp}
\newcommand{\GE}{\hskp\geq\hskp}
\newcommand{\IN}{\hskp\in\hskp}

\newcommand{\NEQ}{\hskp\neq\hskp}
\newcommand{\SUB}{\hskp\subset\hskp}
\newcommand{\SUP}{\hskp\supset\hskp}
\newcommand{\SEQ}{\hskp\subseteq\hskp}
\newcommand{\SPQ}{\hskp\supseteq\hskp}
\newcommand{\NIN}{\hskp\notin\hskp}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Overindexed Delimiters  %%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A correction (personal preference) for the spacing display style summation notation when the indexing term is over-long.

\NewDocumentCommand{\SUM}{mo}{
	\IfNoValueTF{#2}
	{\sum_{\rlap{\scriptsize$#1$}}}
	{\sum_{\rlap{\scriptsize$#1$}}^{\rlap{\scriptsize$#2$}}}}
	
\NewDocumentCommand{\PROD}{mo}{
	\IfNoValueTF{#2}
	{\prod_{\rlap{\scriptsize$#1$}}}
	{\prod_{\rlap{\scriptsize$#1$}}^{\rlap{\scriptsize$#2$}}}}
	
\NewDocumentCommand{\CUP}{mo}{
	\IfNoValueTF{#2}
	{\bigcup_{\rlap{\scriptsize$#1$}}}
	{\bigcup_{\rlap{\scriptsize$#1$}}^{\rlap{\scriptsize$#2$}}}}
	
\NewDocumentCommand{\CAP}{mo}{
	\IfNoValueTF{#2}
	{\bigcap_{\rlap{\scriptsize$#1$}}}
	{\bigcap_{\rlap{\scriptsize$#1$}}^{\rlap{\scriptsize$#2$}}}}
	
\NewDocumentCommand{\VEE}{mo}{
	\IfNoValueTF{#2}
	{\bigvee_{\rlap{\scriptsize$#1$}}}
	{\bigvee_{\rlap{\scriptsize$#1$}}^{\rlap{\scriptsize$#2$}}}}
	
\NewDocumentCommand{\WEDGE}{mo}{
	\IfNoValueTF{#2}
	{\bigwedge_{\rlap{\scriptsize$#1$}}}
	{\bigwedge_{\rlap{\scriptsize$#1$}}^{\rlap{\scriptsize$#2$}}}}
	


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  lpalign  %%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% An environment macro built on the alignat environment from the amsmath package which helps to format mathematical programming problems aesthetically. Takes an optimization direction (#1) [Maximize, Minimize, max, min] and an objective function (#2). The constraints are given, in alignat format, between \begin and \end. Importantly, a double ampersand && should be placed after every line break \\ to preserve spacing. The starred version mutes equation reference tags.


\newlength{\straise}
\setlength{\straise}{.25\baselineskip}
\newlength{\straisedefault}
\setlength{\straisedefault}{0pt}

\newlength{\objraise}
\setlength{\objraise}{.25\baselineskip}
\newlength{\objraisedefault}
\setlength{\objraisedefault}{0pt}

\newlength{\forallspace}
\setlength{\forallspace}{2em}

\NewDocumentEnvironment{lpalign}{mmO{\straisedefault}O{\objraisedefault} +b}
    {\begin{alignat}{4}
     \raisebox{#4}{\text{#1}}\rlap{\hskp$#2$}  &\hskp&  &&  \hspace{\forallspace}  \\
     \raisebox{#3}{\text{s.t.}}  &&  #5
     \end{alignat}}
    {\ignorespacesafterend}
\NewDocumentEnvironment{lpalign*}{mmO{\straisedefault}O{\objraisedefault} +b}
    {\begin{alignat*}{4}
     \raisebox{#4}{\text{#1}}\rlap{\hskp$#2$}  &\hskp&  &&  \hspace{\forallspace}  \\
     \raisebox{#3}{\text{s.t.}}  &&  #5
    \end{alignat*}}
    {\ignorespacesafterend}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Named Paragraphs  %%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A paragraph marker that takes a title (#1) and an optional abbreviation (#2). If the paragraph is labeled, then any reference to it will give the abbreviation (#2) rather than a counter number.

\makeatletter
\newcounter{Para}
\newcounter{NamedPara}
\NewDocumentCommand\paratitle{O{}mo}
    {\hfill\break\indent#1\textbf{#2}
        \IfValueTF{#3}
            {\textbf{(#3)}\refstepcounter{NamedPara}\def\@currentlabel{#3}}
            {\refstepcounter{Para}}
    }
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  Named SubEquations  %%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A subequations-style environment will use a (#1) as the first index in any enclosed equation reference tag. A second index is appended and iterated on. (#2) can be used to change the style of the second index.

\newcounter{NamedEq}
\makeatletter
\newcommand{\lpalign@storestandardsubcurrent}[1]{%
  \begingroup
  \edef\lpalign@full{\theequation}%
  \edef\lpalign@prefix{\theparentequation}%
  \edef\lpalign@tmpdef{%
    \def\noexpand\lpalign@stripaux####1\lpalign@prefix####2\noexpand\@nil{%
      \xdef\noexpand\lpalign@tmp{####2}%
    }%
  }%
  \lpalign@tmpdef
  \expandafter\lpalign@stripaux\lpalign@full\@nil
  \expandafter\xdef\csname subeqref@#1\endcsname{\lpalign@tmp}%
  \endgroup
}
\let\lpalign@baselabel\label
\let\lpalign@baseltxlabel\ltx@label
\let\lpalign@origsubequations\subequations
\let\lpalign@endorigsubequations\endsubequations
\RenewDocumentEnvironment{subequations}{}%
  {\lpalign@origsubequations
   \let\lpalign@subeqoriglabel\label
   \let\lpalign@subeqorigltxlabel\ltx@label
   \def\lpalign@subeqstoresubcurrent##1{%
     \lpalign@storestandardsubcurrent{##1}%
   }%
   \@ifundefined{theHequation}{}%
     {\renewcommand{\theHequation}{lpalign.subequation.\arabic{parentequation}.\arabic{equation}}}%
   \RenewDocumentCommand{\label}{m}{%
     \lpalign@subeqoriglabel{##1}%
     \lpalign@subeqstoresubcurrent{##1}%
   }%
   \renewcommand{\ltx@label}[1]{%
     \lpalign@subeqorigltxlabel{##1}%
     \lpalign@subeqstoresubcurrent{##1}%
   }}
  {\lpalign@endorigsubequations}

\NewDocumentEnvironment{namedsubeqs}{mO{\alph}}
  {\begin{subequations}
     \refstepcounter{NamedEq}
     \let\lpalign@namedoriglabel\lpalign@baselabel
     \let\lpalign@namedorigltxlabel\lpalign@baseltxlabel
     \def\@currentlabel{#1}
     \renewcommand{\theequation}{#1.{#2{equation}}}
     \def\lpalign@namedstoresubcurrent##1{%
       \expandafter\xdef\csname subeqref@##1\endcsname{#2{equation}}%
     }%
     \RenewDocumentCommand{\label}{m}{%
       \lpalign@namedoriglabel{##1}%
       \lpalign@namedstoresubcurrent{##1}%
     }%
     \renewcommand{\ltx@label}[1]{%
       \lpalign@namedorigltxlabel{##1}%
       \lpalign@namedstoresubcurrent{##1}%
     }%
     \@ifundefined{theHequation}{}%
       {\renewcommand{\theHequation}{lpalign.\arabic{NamedEq}.\arabic{equation}}}}
  {\end{subequations}
     \ignorespacesafterend
     \unskip
  }
\makeatother

% \subref and \subeqref work like \ref and \eqref but only reference the
% secondary, sub-index of the tag. This implementation uses \sublabel to store
% the current sub-index explicitly.
\makeatletter
\newcommand{\lpalignhyperref}[2]{%
  \@ifundefined{hyperref}{#2}{\hyperref[#1]{#2}}%
}
\newcommand{\lpalign@newsubref}[2]{%
  \expandafter\gdef\csname subeqref@#1\endcsname{#2}%
}
\newcommand{\lpalignnewsubref}[2]{%
  \lpalign@newsubref{#1}{#2}%
}
\newcommand{\sublabel}[1]{%
  \label{#1}%
  \@ifundefined{lpalign@namedstoresubcurrent}
    {\lpalign@storestandardsubcurrent{#1}}
    {\lpalign@namedstoresubcurrent{#1}}%
}
\makeatother
\ExplSyntaxOn
\cs_new:Npn \lpalignsubreftext #1
 {
  \tl_set:Nx \l_tmpa_tl { \csname subeqref@#1\endcsname }
  \l_tmpa_tl
 }
\NewDocumentCommand{\subref}{m}
 {
  \lpalignhyperref{#1}{{\lpalignsubreftext{#1}}}
 }
\NewDocumentCommand{\subeqref}{m}
 {
  \lpalignhyperref{#1}{\csname tagform@\endcsname {{\lpalignsubreftext{#1}}}}
 }
\ExplSyntaxOff
