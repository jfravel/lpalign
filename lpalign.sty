%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%  lpregion  %%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A truncated version of lpalign environment for formatting only the feasible region.

\ExplSyntaxOn
% Package defaults
\tl_new:N \g_lpregion_default_flush
% Text inputs
\tl_new:N \lpregion_flush

% Package options
\keys_define:nn { lpalign/package }
		{
		region-flush .choices:nn =
		  { a, l, c, r }
		  { \tl_gset_eq:NN \g_lpregion_default_flush \l_keys_choice_tl },
		region-flush .initial:n = a,
		}
 
\keys_define:nn { lpalign/region }
	{
	row-sep .dim_set:N = \lpalign_row_sep,
	qualifier-sep .dim_set:N = \lpalign_qualifier_sep,
	flush .choices:nn =
	  { a, l, c, r }
	  { \tl_set_eq:NN \lpregion_flush \l_keys_choice_tl },
	flush .initial:n = a,
	}

\cs_new_protected:Npn \lpregion_setup:n #1
	{
	\tl_set_eq:NN \lpregion_flush \g_lpregion_default_flush
	\dim_set_eq:NN \lpalign_row_sep \g_lpalign_default_row_sep
	\dim_set_eq:NN \lpalign_qualifier_sep \g_lpalign_default_qualifier_sep
	\tl_if_blank:nF {#1} { \keys_set:nn { lpalign/region } { #1 } }
	}


