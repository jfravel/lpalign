  namedpara-indent .initial:n = 2em,
  namedpara-before .tl_gset:N = \g_lpalign_namedpara_default_before_tl,
  namedpara-before .initial:n = ,
  namedpara-after .tl_gset:N = \g_lpalign_namedpara_default_after_tl,
  namedpara-after .initial:n = ,
